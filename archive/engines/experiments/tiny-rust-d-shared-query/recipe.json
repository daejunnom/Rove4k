  "changes": [
    {
      "file": "board.rs",
      "old": "    pub fn parse(&self, text: &str) -> Option<Move> {",
      "new": "    // One shared membership/copy-make query; callers retain phase ownership.\n    #[inline(never)]\n    pub fn query(&self, wanted: Option<Move>) -> Option<(Move, Self)> {\n        let moves = self.pseudo();\n        for &m in &moves.a[..moves.n] {\n            if let Some(wanted) = wanted { if wanted != m { continue; } }\n            if let Some(child) = self.play(m) { return Some((m, child)); }\n        }\n        None\n    }\n    pub fn parse(&self, text: &str) -> Option<Move> {"
    },
    {
      "file": "board.rs",
      "old": "    pub fn parse_bytes(&self, b: &[u8]) -> Option<Move> {",
      "new": "    pub fn parse_bytes(&self, b: &[u8]) -> Option<Move> {\n        self.parse_child_bytes(b).map(|(m, _)| m)\n    }\n    pub fn parse_child_bytes(&self, b: &[u8]) -> Option<(Move, Self)> {"
    },
    {
      "file": "board.rs",
      "old": "        let moves = self.pseudo();\n        (moves.a[..moves.n].contains(&m) && self.play(m).is_some()).then_some(m)",
      "new": "        self.query(Some(m))"
    },
    {
      "file": "main.rs",
      "old": "b=b.play(b.parse_bytes(text)?)?;",
      "new": "let(_,child)=b.parse_child_bytes(text)?;b=child;"
    },
    {
      "file": "runtime.rs",
      "old": "let moves=board.legal();job.fallback=moves.a[..moves.n].first().copied().unwrap_or(0);",
      "new": "job.fallback=board.query(None).map_or(0,|(m,_)|m);"
    },
    {
      "file": "runtime.rs",
      "old": "let legal=job.board.legal();if !legal.a[..legal.n].contains(&result.best){result.best=0;}",
      "new": "if job.board.query(Some(result.best)).is_none(){result.best=0;}"
    }
  ],
