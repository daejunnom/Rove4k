  "changes": [
    {
      "file": "tiny.h",
      "old": "typedef struct { atomic_flag lock; uint64_t key,data; } Entry;",
      "new": "typedef struct { _Alignas(16) uint64_t key; uint64_t data; } Entry;\n_Static_assert(sizeof(Entry)==16 && _Alignof(Entry)==16 &&\n               offsetof(Entry,key)==0 && offsetof(Entry,data)==8,\"atomic128 TT layout\");"
    },
    {
      "file": "search.c",
      "old": "/* A slot is acquired without waiting. Contention is a miss, never a torn\n * key/payload publication. Search workers share slots, not mutable heuristics. */\nstatic uint64_t probe(uint64_t key,int write,uint64_t data){\n    Entry *e=table+(key&((1u<<TT_BITS)-1));\n    if(atomic_flag_test_and_set_explicit(&e->lock,memory_order_acquire))return 0;\n    if(write)e->key=key,e->data=data;\n    else data=e->key==key?e->data:0;\n    atomic_flag_clear_explicit(&e->lock,memory_order_release);\n    return data;\n}",
      "new": "/* Full key/payload pairs use aligned atomic16 operations. One write CAS may\n * lose to another publisher; no lock state, retry or partial key is used. */\nstatic uint64_t probe(uint64_t key,int write,uint64_t data){\n    Entry *e=table+(key&((1u<<TT_BITS)-1));\n    uint64_t lo=0,hi=0;\n    __asm__ volatile(\"lock cmpxchg16b %0\":\"+m\"(*e),\"+a\"(lo),\"+d\"(hi):\"b\"(0ull),\"c\"(0ull):\"cc\",\"memory\");\n    if(write){\n        __asm__ volatile(\"lock cmpxchg16b %0\":\"+m\"(*e),\"+a\"(lo),\"+d\"(hi):\"b\"(key),\"c\"(data):\"cc\",\"memory\");\n    }else data=lo==key?hi:0;\n    return data;\n}"
    },
    {
      "file": "runtime.c",
      "old": "static void clear(void){for(size_t i=0;i<((size_t)1<<TT_BITS);i++){table[i].key=table[i].data=0;atomic_flag_clear(&table[i].lock);}}",
      "new": "#if DEV\nstatic void clear(void){memset(table,0,((size_t)1<<TT_BITS)*sizeof *table);}\n#endif"
    },
    {
      "file": "runtime.c",
      "old": "table=allocate(((size_t)1<<TT_BITS)*sizeof *table);if(!table)return 2;clear();start(&position);",
      "new": "table=allocate(((size_t)1<<TT_BITS)*sizeof *table);if(!table)return 2;start(&position);"
    }
  ],
