/* Included after the exact readable translation unit with its main renamed.
 * This uses the real search/TT/learning implementation, not a duplicate model.
 * Single-worker deterministic evidence is supplemented by actual SMP protocol
 * checks of selected production wrappers. No wall/NPS comparison is made.
 */
static uint64_t digest(uint64_t h,const void *p,size_t n){
    const unsigned char *s=p;
    while(n--)h=(h^*s++)*UINT64_C(1099511628211);
    return h;
}
int main(void){
    static const struct {const char *fen;int depth;} cases[]={
        {"startpos",4},
        {"r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",3},
        {"6k1/8/8/3pP3/8/8/8/6K1 w - d6 0 1",4},
        {"7k/8/8/8/8/8/1Q6/K7 w - - 99 1",3},
        {"7k/8/8/8/8/8/1Q6/K7 w - - 0 1",3},
        {"7k/8/8/8/8/8/P7/K7 w - - 0 1",4},
        {"1r5k/P7/8/8/8/8/8/7K w - - 0 1",3},
        {"6k1/5ppp/8/8/8/8/5PPP/6K1 w - - 0 1",4},
        {"6k1/1q6/8/8/8/8/1Q6/K7 w - - 0 1",4},
        {"7k/6Q1/6K1/8/8/8/8/8 b - - 100 1",4},
        {"7k/5Q2/6K1/8/8/8/8/8 b - - 0 1",3},
        {"startpos",4}
    };
    table=calloc((size_t)1<<TT_BITS,sizeof *table);if(!table)return 2;
    clear();Worker *w=workers;
    for(unsigned c=0;c<sizeof cases/sizeof *cases;c++){
        Board b;if(!strcmp(cases[c].fen,"startpos"))start(&b);else if(!fen(&b,cases[c].fen))return 3;
        game_length=1;game_keys[0]=b.h;max_depth=cases[c].depth;limit=0;deadline=UINT64_MAX;
        atomic_store(&searched,0);atomic_store(&stopped,0);w->best=0;think(w,&b);
        uint64_t h=UINT64_C(1469598103934665603),tt=h;
        h=digest(h,w->history,sizeof w->history);h=digest(h,w->continuation,sizeof w->continuation);
        h=digest(h,w->correction,sizeof w->correction);h=digest(h,w->keys,sizeof w->keys);
        for(size_t i=0;i<((size_t)1<<TT_BITS);i++){
            tt=digest(tt,&table[i].key,sizeof table[i].key);
            tt=digest(tt,&table[i].data,sizeof table[i].data);
        }
        printf("{\"case\":%u,\"best\":%u,\"score\":%d,\"depth\":%d,\"nodes\":%llu,\"learning_path\":\"%016llx\",\"tt\":\"%016llx\",\"pvs\":%llu,\"qs\":%llu,\"hits\":%llu,\"hist\":%llu,\"cont\":%llu,\"corr\":%llu,\"corr_use\":%llu,\"abort\":%llu,\"stopped\":%d}\n",
            c,w->best,w->score,w->depth,(unsigned long long)w->nodes,(unsigned long long)h,(unsigned long long)tt,
            (unsigned long long)w->pvs,(unsigned long long)w->qs,(unsigned long long)w->hits,
            (unsigned long long)w->hist_updates,(unsigned long long)w->cont_updates,
            (unsigned long long)w->corr_updates,(unsigned long long)w->corr_uses,
            (unsigned long long)w->ply_aborts,atomic_load(&stopped));
    }
    free(table);return 0;
}
