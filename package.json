{
  "name": "rove4k-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rove4k engine workspace and internal Rust NVCompact tooling",
  "type": "module",
  "workspaces": ["tools/nvcompact/npm"],
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "npm run build:nvcompact",
    "build:nvcompact": "node tools/nvcompact/scripts/build.mjs",
    "test": "node tools/nvcompact/scripts/test-cli.mjs",
    "test:core": "node tools/nvcompact/scripts/cargo.mjs test --workspace --locked",
    "test:nvcompact": "npm test && npm run test:core",
    "pack:nvcompact": "node tools/nvcompact/scripts/pack.mjs",
    "pack:cli": "npm run pack:nvcompact",
    "verify:package": "node tools/nvcompact/scripts/verify-package.mjs",
    "release:prepare": "node tools/nvcompact/scripts/release.mjs prepare",
    "publish:nvcompact": "node tools/nvcompact/scripts/release.mjs publish",
    "test:release": "node tools/nvcompact/scripts/release.test.mjs",
    "github:prepare": "node tools/nvcompact/scripts/github-packages.mjs prepare",
    "github:publish": "node tools/nvcompact/scripts/github-packages.mjs publish",
    "test:github-packages": "node --test tools/nvcompact/scripts/github-packages.test.mjs",
    "repo": "node scripts/repository.mjs",
    "test:repo": "node --test scripts/repository.test.mjs"
  }
}
