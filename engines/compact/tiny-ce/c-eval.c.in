/* C: the fixed AVX2 target evaluates eight mailbox squares per iteration.
 * A packed gather holds material in bits 0..9, rank weight in 10..13,
 * and center weight plus three in 14..; no feature table is initialized.
 * The returned white score comes from SIMD lanes, independent of Board.v.
 */
#include <immintrin.h>
#if DEV
static atomic_uint_fast64_t tiny_leaf_calls,tiny_order_calls;
static int tiny_scalar(const Board *p){
    int score=0;
    for(int q=0;q<128;q++)if(!(q&0x88)&&p->b[q])score+=value(p->b[q],q);
    return score;
}
#endif
static int tiny_raw(const Board *p){
    static const int terms[8]={49152,89188,196928,131402,51700,82820,0,0};
    __m256i sum=_mm256_setzero_si256();
#if DEV
    atomic_fetch_add_explicit(&tiny_leaf_calls,1,memory_order_relaxed);
#endif
    for(int r=0;r<8;r++){
        __m256i pieces=_mm256_cvtepi8_epi32(_mm_loadl_epi64((const __m128i *)(p->b+r*16)));
        __m256i weights=_mm256_i32gather_epi32(terms,_mm256_abs_epi32(pieces),4);
        __m256i advance=_mm256_blendv_epi8(_mm256_set1_epi32(r),_mm256_set1_epi32(7-r),pieces);
        __m256i center=_mm256_sub_epi32(_mm256_set1_epi32(7-abs(2*r-7)),_mm256_setr_epi32(7,5,3,1,1,3,5,7));
        __m256i score=_mm256_add_epi32(_mm256_and_si256(weights,_mm256_set1_epi32(1023)),
            _mm256_mullo_epi32(advance,_mm256_and_si256(_mm256_srli_epi32(weights,10),_mm256_set1_epi32(15))));
        score=_mm256_add_epi32(score,_mm256_mullo_epi32(center,
            _mm256_sub_epi32(_mm256_srli_epi32(weights,14),_mm256_set1_epi32(3))));
        sum=_mm256_add_epi32(sum,_mm256_sign_epi32(score,pieces));
    }
    __m128i half=_mm_add_epi32(_mm256_castsi256_si128(sum),_mm256_extracti128_si256(sum,1));
    half=_mm_hadd_epi32(half,half);
    return _mm_cvtsi128_si32(_mm_hadd_epi32(half,half));
}
static int tiny_order(const Board *p,Move m){(void)p;(void)m;return 0;}
