+inline bool fail(const char* why) {
+    std::fprintf(stderr, "ROVE_START_GATE_ABORT: %s\n", why);
+    std::fflush(stderr);
+    return false;
+}
+
+// Called in main, before any engine process can be spawned. pass_fds clears
+// CLOEXEC for the runner, so reapply it here before engines inherit anything.
+inline bool prepare() {
+    const char* raw = std::getenv("ROVE_START_FD");
+    const char* metadata = std::getenv("ROVE_START_JOB");
+    const char* protocol = std::getenv("ROVE_START_PROTOCOL");
+    const char* opening_raw = std::getenv("ROVE_OPENING_FD");
+#ifndef _WIN64
+    int opening_fd = -1;
+#endif
+#ifdef __linux__
+    if (opening_raw) {
+        char* end = nullptr;
+        errno = 0;
+        const long fd = std::strtol(opening_raw, &end, 10);
+        if (errno || !end || *end || end == opening_raw || fd < 3 || fd > std::numeric_limits<int>::max())
+            return fail("invalid opening FD");
+        opening_fd = static_cast<int>(fd);
+        const int flags = fcntl(opening_fd, F_GETFD);
+        const int seals = fcntl(opening_fd, F_GET_SEALS);
+        const int required = F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE;
+        if (flags < 0 || seals < 0 || (seals & required) != required ||
+            fcntl(opening_fd, F_SETFD, flags | FD_CLOEXEC) < 0)
+            return fail("cannot protect sealed opening FD");
+        if (unsetenv("ROVE_OPENING_FD") != 0) return fail("cannot clear opening FD environment");
+    }
+#else
+    if (opening_raw) return fail("sealed opening FD requires Linux");
+#endif
+    if (!raw) return (metadata || protocol) ? fail("job or protocol without control FD") : true;
+#ifdef _WIN64
+    return fail("the league start gate requires POSIX");
+#else
+    char* end = nullptr;
+    errno = 0;
+    const long fd = std::strtol(raw, &end, 10);
+    if (errno || !end || *end || end == raw || fd < 3 || fd > std::numeric_limits<int>::max())
+        return fail("invalid control FD");
+    control_fd = static_cast<int>(fd);
+    if (control_fd == opening_fd) return fail("opening and control FDs must differ");
+    if (protocol) {
+        if (std::string(protocol) != "2") return fail("unknown start protocol");
+        go2_required = true;
+    }
+    const int flags = fcntl(control_fd, F_GETFD);
+    if (flags < 0 || fcntl(control_fd, F_SETFD, flags | FD_CLOEXEC) < 0)
+        return fail("cannot protect control FD");
+    int type = 0;
+    socklen_t length = sizeof(type);
+    sockaddr_un address{};
+    socklen_t address_length = sizeof(address);
+    if (getsockopt(control_fd, SOL_SOCKET, SO_TYPE, &type, &length) || type != SOCK_STREAM ||
+        getsockname(control_fd, reinterpret_cast<sockaddr*>(&address), &address_length) ||
+        address.sun_family != AF_UNIX)
+        return fail("control FD must be a Unix stream socket");
+    if (!metadata || std::char_traits<char>::length(metadata) > 4096)
+        return fail("missing or excessive job metadata");
+    try {
+        job = nlohmann::json::parse(metadata);
+        if (!job.is_object()) return fail("job metadata must be an object");
+    } catch (...) {
+        return fail("invalid job JSON");
+    }
+    return true;
+#endif
+}
+
+#ifndef _WIN64
+inline int poll_left(std::chrono::steady_clock::time_point deadline) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= deadline) return 0;
+    const auto left = std::chrono::ceil<std::chrono::milliseconds>(deadline - now).count();
+    return static_cast<int>(left > std::numeric_limits<int>::max() ?
+                            std::numeric_limits<int>::max() : left);
+}
+
+inline bool send_until(const std::string& message, std::chrono::steady_clock::time_point deadline) {
+    size_t sent = 0;
+    while (sent < message.size()) {
+        if (!poll_left(deadline)) return false;
+        const auto count = send(control_fd, message.data() + sent, message.size() - sent,
+                                MSG_NOSIGNAL | MSG_DONTWAIT);
+        if (count > 0) { sent += static_cast<size_t>(count); continue; }
+        if (count < 0 && errno == EINTR) continue;
+        if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            pollfd fd{control_fd, POLLOUT, 0};
+            const int left = poll_left(deadline);
+            if (left && poll(&fd, 1, left) > 0 && !(fd.revents & (POLLERR | POLLHUP | POLLNVAL))) continue;
+        }
+        return false;
+    }
+    // The last send can itself cross the deadline. The peer may nevertheless
+    // have received bytes and must reconcile an expired or missing receipt.
+    return poll_left(deadline) != 0;
+}
+
+// A GO2 receipt confirms only that this local runner validated the command.
+// It neither authenticates the sender nor proves the engine began searching.
+inline bool accept_go2(const std::string& command, std::chrono::steady_clock::time_point deadline) {
+    if (command.compare(0, 4, "GO2 ") || command.back() != '\n') return fail("invalid controller command");
+    std::string fields[4];
+    size_t start = 4;
+    for (int i = 0; i < 4; ++i) {
+        const auto end = command.find(i == 3 ? '\n' : ' ', start);
+        if (end == std::string::npos || end == start || (i == 3 && end != command.size() - 1))
+            return fail("invalid GO2 fields");
+        fields[i] = command.substr(start, end - start);
+        start = end + 1;
+    }
+    auto identifier = [](const std::string& value, size_t min, size_t max, bool first_alnum) {
+        if (value.size() < min || value.size() > max) return false;
+        for (size_t i = 0; i < value.size(); ++i) {
+            const char c = value[i];
+            const bool alnum = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
+            if (!alnum && ((first_alnum && i == 0) || (c != '_' && c != '.' && c != '-'))) return false;
+        }
+        return true;
+    };
+    auto digest = [](const std::string& value) {
+        if (value.size() != 64) return false;
+        for (const char c : value) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+        return true;
+    };
+    if (!identifier(fields[0], 16, 128, true) || !identifier(fields[1], 1, 96, false) ||
+        !digest(fields[2]) || !digest(fields[3]) || !job.contains("attempt_id") ||
+        !job["attempt_id"].is_string() || job["attempt_id"].get<std::string>() != fields[0])
+        return fail("invalid GO2 binding");
+    const auto ack = nlohmann::json{{"event", "GO2_ACCEPTED"}, {"attempt_id", fields[0]},
+        {"fence_id", fields[1]}, {"job_sha256", fields[2]}, {"nonce", fields[3]}}.dump() + "\n";
+    // A failed or partial reply aborts the gate. A full reply can still be
+    // lost before the controller reads it, so that side must reconcile EOF.
+    return send_until(ack, deadline) ? true : fail("GO2 receipt delivery failed or timed out");
+}
+#endif
+
+inline bool await_start(int64_t white_clock, int64_t black_clock) {
+    if (control_fd < 0) return true;
+    if (gate_used.exchange(true)) return fail("one runner must own exactly one game");
+#ifdef _WIN64
+    return fail("the league start gate requires POSIX");
+#else
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(180);
+    const std::string message = nlohmann::json{{"event", "READY"}, {"job", job},
+        {"white_clock_ms", white_clock}, {"black_clock_ms", black_clock}}.dump() + "\n";
+    if (!send_until(message, deadline)) return fail("READY delivery failed or timed out");
+    std::string command;
+    while (true) {
+        const int left = poll_left(deadline);
+        if (!left) return fail("controller start deadline expired");
+        pollfd fd{control_fd, POLLIN, 0};
+        const int ready = poll(&fd, 1, left);
+        if (ready < 0 && errno == EINTR) continue;
+        if (ready <= 0) return fail("controller start deadline expired or poll failed");
+        if (fd.revents & POLLIN) {
+            char buffer[32];
+            const auto count = recv(control_fd, buffer, sizeof(buffer), MSG_DONTWAIT);
+            if (count < 0 && (errno == EINTR || errno == EAGAIN)) continue;
+            if (count <= 0) return fail("controller disconnected");
+            for (ssize_t i = 0; i < count; ++i) {
+                command += buffer[i];
+                if (command.size() > 384) return fail("invalid controller command");
+                if (buffer[i] == '\n') {
+                    if (command == "GO\n" && !go2_required) return true;
+                    if (go2_required && command.compare(0, 4, "GO2 ") == 0) {
+                        if (i + 1 != count) return fail("extra GO2 command bytes");
+                        // Reject already queued trailing bytes too; this does
+                        // not assert that a peer cannot write more later.
+                        char trailing;
+                        ssize_t extra;
+                        do { extra = recv(control_fd, &trailing, 1, MSG_PEEK | MSG_DONTWAIT); }
+                        while (extra < 0 && errno == EINTR);
+                        if (extra > 0 || (extra < 0 && errno != EAGAIN && errno != EWOULDBLOCK))
+                            return fail("extra GO2 command bytes");
+                        return accept_go2(command, deadline);
+                    }
+                    return fail(command == "ABORT\n" ? "controller aborted wave" : "invalid controller command");
+                }
+            }
+        }
+        if (fd.revents & (POLLERR | POLLHUP | POLLNVAL)) return fail("controller disconnected");
+    }
+#endif
+}
