                if(moves){
                    add(moves,&n,from,to,a==1);
                    if(a==6&&i<10&&from==(s>0?4:116)&&!target&&
                       (p->c&(1<<(i-8+2*(s<0))))&&!p->b[to+d]&&
                       (d>0||!p->b[to+2*d])&&!attacked(p,from,-s)&&!attacked(p,to,-s))
                        add(moves,&n,from,to+d,0);
                }
                if(target||a<3||a==6)break;
            }
        }
