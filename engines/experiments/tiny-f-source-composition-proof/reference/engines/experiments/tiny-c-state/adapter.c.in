/* Fixture-only bridge around an actual frozen DEV=0 translation unit.
 * No Board layout crosses this ABI; both production sources stay untouched. */
#define _POSIX_C_SOURCE 200809L
#include <stdint.h>
#include <stdatomic.h>
#include <pthread.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <time.h>
#include <limits.h>
#include <ctype.h>
#include <errno.h>
#include <immintrin.h>
#include <assert.h>
#include "state_contract.h"
@NAMESPACE@
#include @PRODUCTION_SOURCE@
#undef main

@FIXTURE_FEN@

static void api_start(void *p){start(p);}
static int api_fen(void *p,const char *s){return fixture_fen_board(p,s);}
static int api_gen(const void *p,unsigned *moves){return gen(p,moves);}
static int api_make(const void *p,unsigned m,void *q){return make(p,m,q);}
static void api_snapshot(const void *input,RoveStateSnapshot *out){
    const Board *p=input;memset(out,0,sizeof *out);memcpy(out->cells,p->b,128);
    out->side=p->s;out->rights=p->c;out->ep=p->e;
    out->kings[0]=p->k[0];out->kings[1]=p->k[1];out->halfmove=p->half;
    out->hash=p->h;out->reversible=p->r;
}
static int api_raw(const void *p){return tiny_raw(p);}
static int api_value(int piece,int square){return value(piece,square);}
static int api_table(int piece,int square){return tiny_table[(piece+6)*64+square];}
static int api_dead(const void *p){return dead(p);}
static uint64_t api_key(const void *input){const Board *p=input;return p->h^mix(p->r+(unsigned)p->half);}
@CACHE_GETTER@
const RoveStateAPI @API_NAME@={"@LABEL@",sizeof(Board),api_start,api_fen,api_gen,api_make,api_snapshot,
    api_raw,api_value,api_table,api_dead,api_key,@CACHE_CALLBACK@};

static Worker core_worker;
static void core_reset(Board *p){
    clear();memset(&core_worker,0,sizeof core_worker);start(p);
    core_worker.length=1;core_worker.keys[0]=p->h;
    deadline=UINT64_MAX;atomic_store(&stopped,0);
}
int @CORE_NAME@(void){
    table=calloc(1u<<TT_BITS,sizeof *table);assert(table);
    Board p,q;Worker *w=&core_worker;Move best=0;int checks=0;
    core_reset(&p);
    uint64_t key=p.h^mix(p.r+(unsigned)p.half);
    uint64_t data=((uint64_t)27123<<17)|((uint64_t)10<<33)|((uint64_t)1<<41);
    probe(key,1,data);assert(probe(key,0,0)==data);
    assert(probe(key+((uint64_t)1<<TT_BITS),0,0)==0);checks++;
    assert(search(w,&p,1,-MATE,MATE,1,0,0)==27123);
    q=p;q.half++;assert((q.h^mix(q.r+(unsigned)q.half))!=key);
    memset(w,0,sizeof *w);w->length=1;w->keys[0]=q.h;
    assert(search(w,&q,1,-MATE,MATE,1,0,0)!=27123);checks++;
    clear();probe(key,1,data);q=p;q.r++;
    assert((q.h^mix(q.r+(unsigned)q.half))!=key);
    memset(w,0,sizeof *w);w->length=1;w->keys[0]=q.h;
    assert(search(w,&q,1,-MATE,MATE,1,0,0)!=27123);checks++;

    core_reset(&p);w->length=5;w->keys[0]=w->keys[2]=w->keys[4]=p.h;p.half=4;
    assert(search(w,&p,1,-MATE,MATE,0,0,&best)==0);
    assert(w->nodes==1&&!atomic_load(&stopped));checks++;
    core_reset(&p);w->length=3;w->keys[0]=w->keys[2]=p.h;p.half=4;
    best=0;search(w,&p,1,-MATE,MATE,0,0,&best);assert(best&&w->nodes>1);checks++;
    core_reset(&p);p.half=100;
    assert(search(w,&p,1,-MATE,MATE,0,0,&best)==0&&!atomic_load(&stopped));checks++;
    assert(fixture_fen_board(&p,"7k/6Q1/5K2/8/8/8/8/8 b - - 100 1"));
    memset(w,0,sizeof *w);w->length=1;w->keys[0]=p.h;
    assert(search(w,&p,1,-MATE,MATE,0,0,&best)==-MATE);checks++;

    core_reset(&p);best=0;
    int score=search(w,&p,4,-MATE,MATE,0,0,&best);
    assert(!atomic_load(&stopped)&&best&&w->nodes>1);
    int hist=0,cont=0,corr=0;
    for(int i=0;i<128;i++)for(int j=0;j<128;j++)hist|=w->history[i][j]!=0;
    for(int i=0;i<13;i++)for(int j=0;j<13;j++)cont|=w->continuation[i][j]!=0;
    for(int i=0;i<1024;i++)corr|=w->correction[i]!=0;
    assert(hist&&cont&&corr);checks++;
    /* A genuine completed depth-four actual shipping search establishes the
     * retained fields before the real nonterminal ply-cap abort branch. */
    w->depth=4;w->score=score;w->best=best;
    int completed_score=w->score;Move completed_best=w->best;
    w->length=1;w->keys[0]=p.h;
    assert(search(w,&p,1,-MATE,MATE,PLY-1,0,0)==0&&atomic_load(&stopped));
    assert(w->depth==4&&w->score==completed_score&&w->best==completed_best);checks++;

    core_reset(&p);assert(fixture_fen_board(&p,"4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1"));
    w->length=1;w->keys[0]=p.h;Move ep_move=MOVE(68,83,0);
    assert(p.e==83&&capture(&p,ep_move)&&!PROMO(ep_move));
    best=0;search(w,&p,1,-MATE,MATE,0,0,&best);
    assert(!atomic_load(&stopped)&&best==ep_move);
    for(int i=0;i<1024;i++)assert(!w->correction[i]);checks++;
    free(table);table=0;return checks;
}
