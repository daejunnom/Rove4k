      "changes": {
        "shipping": [
          {
            "role": "Board-cache-field",
            "old": "typedef struct{int8_t b[128];int s,c,e,k[2],aI,v;uint64_t h,r;}E;",
            "new": "typedef struct{int8_t b[128];int s,c,e,k[2],aI,v,m;uint64_t h,r;}E;"
          },
          {
            "role": "one-square-old-new-owner",
            "old": "static void bf(E*p,int q,int v){int a=p->b[q];if(a){p->h^=bb(a,q);p->v-=al(a,q);}p->b[q]=(int8_t)v;if(v){p->h^=bb(v,q);p->v+=al(v,q);if(abs(v)==6)p->k[v<0]=q;}}",
            "new": "static void bf(E*p,int q,int v){for(int a=p->b[q],d=-1;d<2;d+=2,a=v)if(a){int z=abs(a);p->h^=bb(a,q);p->v+=d*al(a,q);if(z==6)p->k[a<0]=q;else p->m+=d*(z==3?1<<(((q+(q>>4))&1)*6):z==2?4096:262144);}p->b[q]=(int8_t)v;}"
          },
          {
            "role": "O1-exact-dead",
            "old": "int ap(const E*p){int d=0,f=0,g=0;for(int q=0;q<128;q++)if(!(q&0x88)){int a=abs(p->b[q]);if(a==2){d++;f++;}else if(a==3){d++;g|=1<<((q+(q>>4))&1);}else if(a&&a<6)return 0;}return d<2||(!f&&g!=3);}",
            "new": "int ap(const E*p){int m=p->m;return m<262144&&(m%63<2||m<4096&&(!(m&63)||m<64));}"
          }
        ],
        "readable": [
          {
            "role": "Board-cache-field",
            "old": "typedef struct { int8_t b[128]; int s,c,e,k[2],half,v; uint64_t h,r; } Board;",
            "new": "typedef struct { int8_t b[128]; int s,c,e,k[2],half,v,material; uint64_t h,r; } Board;"
          },
          {
            "role": "one-square-old-new-owner",
            "old": "static void put(Board *p,int q,int v){\n    int old=p->b[q];\n    if(old){p->h^=piece(old,q);p->v-=value(old,q);}\n    p->b[q]=(int8_t)v;\n    if(v){p->h^=piece(v,q);p->v+=value(v,q);if(abs(v)==6)p->k[v<0]=q;}\n}\n",
            "new": "static void put(Board *p,int q,int v){\n    for(int old=p->b[q],sign=-1;sign<2;sign+=2,old=v)if(old){\n        int a=abs(old);\n        p->h^=piece(old,q);p->v+=sign*value(old,q);\n        if(a==6)p->k[old<0]=q;\n        else p->material+=sign*(a==3?1<<(((q+(q>>4))&1)*6):a==2?4096:262144);\n    }\n    p->b[q]=(int8_t)v;\n}\n"
          },
          {
            "role": "O1-exact-dead",
            "old": "int dead(const Board *p){\n    int minors=0,knights=0,colors=0;\n    for(int q=0;q<128;q++)if(!(q&0x88)){\n        int a=abs(p->b[q]);\n        if(a==2){minors++;knights++;}\n        else if(a==3){minors++;colors|=1<<((q+(q>>4))&1);}\n        else if(a&&a<6)return 0;\n    }\n    return minors<2||(!knights&&colors!=3);\n}\n",
            "new": "int dead(const Board *p){\n    int m=p->material;\n    return m<262144&&(m%63<2||m<4096&&(!(m&63)||m<64));\n}\n"
          },
          {
            "role": "DEV-reconstruction-check",
            "old": "if(kings[0]!=1||kings[1]!=1||memcmp(p->k,t.k,sizeof t.k)||p->v!=t.v)return 0;",
            "new": "if(kings[0]!=1||kings[1]!=1||memcmp(p->k,t.k,sizeof t.k)||p->v!=t.v||p->material!=t.material)return 0;"
          }
        ]
